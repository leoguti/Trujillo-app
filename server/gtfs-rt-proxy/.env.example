# Copy to .env to override defaults. Both proxy and simulator services
# read this file automatically via docker compose.

# Toggle simulation. When true, the proxy reads from the local simulator
# container instead of the S3 driver feed. OTP doesn't need any change —
# it keeps polling the proxy's URL.
SIMULATED=false

# How many synthetic clones of each real recorded trajectory the simulator
# should emit. Bigger = more vehicles on the map; cost is negligible.
CLONE_FACTOR=3

# Hard cap on the total number of simulated vehicles. Applied AFTER
# CLONE_FACTOR. 0 means no cap. Useful to keep the map sparse for testing.
MAX_VEHICLES=0
